{
  "manifest_version": 3,
  "name": "TLSView",
  "version": "0.0.1",
  "description": "Shows which TLS key exchange a site uses: classical, hybrid post-quantum or pure post-quantum (ML-KEM). Work in progress.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "TLSView",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tlsview@bro256",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
